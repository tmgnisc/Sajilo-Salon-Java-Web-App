// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String
  avatar    String?
  role      UserRole @default(CUSTOMER)
  isVerified Boolean @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedSalon Salon?   @relation("SalonOwner")
  bookings  Booking[]
  reviews   Review[]
  notifications Notification[]

  @@map("users")
}

model Salon {
  id          String   @id @default(cuid())
  name        String
  type        SalonType
  address     String
  description String?
  imageUrl    String?
  isVerified  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  openingHour String?  // e.g. "09:00"
  closingHour String?  // e.g. "18:00"
  // Relations
  owner       User     @relation("SalonOwner", fields: [ownerId], references: [id])
  ownerId     String   @unique
  services    Service[]
  bookings    Booking[]
  reviews     Review[]
  documents   SalonDocument[]

  @@map("salons")
}

model SalonDocument {
  id        String   @id @default(cuid())
  name      String
  type      DocumentType
  url       String
  createdAt DateTime @default(now())

  // Relations
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  salonId   String

  @@map("salon_documents")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  duration    Int      // in minutes
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  salonId     String
  bookingServices BookingService[]

  @@map("services")
}

model Booking {
  id        String        @id @default(cuid())
  date      DateTime
  time      String
  status    BookingStatus @default(PENDING)
  totalAmount Float
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  salon     Salon         @relation(fields: [salonId], references: [id])
  salonId   String
  services  BookingService[]

  @@map("bookings")
}

model BookingService {
  id        String   @id @default(cuid())
  price     Float
  createdAt DateTime @default(now())

  // Relations
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
  service   Service  @relation(fields: [serviceId], references: [id])
  serviceId String

  @@map("booking_services")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  salon     Salon    @relation(fields: [salonId], references: [id])
  salonId   String

  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@map("notifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// Enums
enum UserRole {
  CUSTOMER
  SALON_OWNER
  ADMIN
  SUPERADMIN
}

enum SalonType {
  HAIR_SALON
  BEAUTY_SALON
  SPA
  NAIL_SALON
  BARBER_SHOP
  MULTI_SERVICE
}

enum DocumentType {
  BUSINESS_LICENSE
  GST_CERTIFICATE
  PAN_CARD
  AADHAR_CARD
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  BOOKING_CANCELLATION
  SALON_VERIFICATION
  GENERAL
} 